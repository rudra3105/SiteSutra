# ─────────────────────────────────────────────────────────────────
# SiteSutra - Environment Variables
# Copy these into Vercel → Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# DATABASE_URL
# Get this from Vercel → Storage → Create Database → Neon Postgres
# It looks like: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT_SECRET
# Any long random string - used to sign login tokens
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=

# NEXT_PUBLIC_APP_URL
# Your Vercel deployment URL (fill after first deploy)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
