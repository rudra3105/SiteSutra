{
  "name": "construction-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.js && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:seed": "node scripts/seed-local.js",
    "db:studio": "drizzle-kit studio",
    "postinstall": "echo \"Install complete - run npm run db:setup to initialize database\"",
    "setup": "npm run db:push && npm run db:seed",
    "db:setup": "node scripts/seed-local.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.0",
    "jose": "^5.9.6",
    "next": "14.2.18",
    "next-pwa": "^5.6.0",
    "pg": "^8.13.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
